# Copy to .env (ignored by Git) for local `make release`. CI uses GitHub Secrets
# (scripts/setup-github-secrets.py sends these without printing them).
MACOS_P12_FILE="/path/to/DeveloperID.p12"   # Developer ID Application, outside the repo
MACOS_P12_PASSWORD=""
MACOS_TEAM_ID="3Z7C3Q7NMT"
# Optional when the .p12 holds a single Developer ID: SHA-1 or full name.
MACOS_CODESIGN_IDENTITY=""

# Notarization: an app-specific password (never the main account password)...
MACOS_NOTARY_APPLE_ID=""
MACOS_NOTARY_PASSWORD=""
# ...or a profile from `xcrun notarytool store-credentials`.
MACOS_NOTARY_PROFILE=""
